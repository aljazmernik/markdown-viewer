<!--
  Per-user MSI (no admin rights needed). Built by tools/build-installer.ps1:
    dotnet wix build installer/Package.wxs -d Version=1.2.3 -d PublishDir=publish-sc -o setup.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Markdown Viewer"
           Manufacturer="Aljaz Mernik"
           Version="$(Version)"
           UpgradeCode="{6B7E4F2A-3C1D-4E8B-9A5F-2D7C8B1E4F60}"
           Scope="perUser"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades: reinstalling a rebuilt installer of the same version replaces it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Markdown Viewer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/aljazmernik/markdown-viewer" />

    <!-- %LOCALAPPDATA%\Programs\Markdown Viewer -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Markdown Viewer" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- File associations are left to the app (MarkdownViewer.exe with the register option), so
         uninstalling never changes which app opens .md files.
         Per-user components use an HKCU value as key path (MSI rule for user profiles). -->
    <Component Id="App" Directory="INSTALLFOLDER" Guid="{A3D5C1E7-8B24-4F6A-9C0D-5E1F7B2A8C34}">
      <!-- Self-contained build (.NET runtime included), so no separate runtime install is needed. -->
      <File Id="AppExe" Source="$(PublishDir)\MarkdownViewer.exe" />
      <File Id="WebView2Loader" Source="$(PublishDir)\WebView2Loader.dll" />
      <File Id="DocIcon" Source="$(sys.SOURCEFILEDIR)..\file.ico" />
      <File Id="License" Source="$(sys.SOURCEFILEDIR)..\LICENSE" Name="LICENSE.txt" />
      <File Id="Notices" Source="$(sys.SOURCEFILEDIR)..\THIRD-PARTY-NOTICES.md" />
      <RegistryValue Root="HKCU" Key="Software\Markdown Viewer" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppShortcut" Name="Markdown Viewer" Description="View and edit Markdown files"
                Target="[INSTALLFOLDER]MarkdownViewer.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Markdown Viewer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Settings > Apps runs the app's own uninstaller ("MarkdownViewer.exe uninstall" option): it first
         removes a .md registration that points at this copy, then starts the normal MSI uninstall.
         (Programs started by Windows Installer itself see a stale view of the user's file-type
         registry, so this cleanup can't run as a custom action.) The MSI's own entry is hidden. -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <Component Id="UninstallEntry" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\MarkdownViewer">
        <RegistryValue Name="DisplayName" Type="string" Value="Markdown Viewer" KeyPath="yes" />
        <RegistryValue Name="DisplayVersion" Type="string" Value="[ProductVersion]" />
        <RegistryValue Name="Publisher" Type="string" Value="Aljaz Mernik" />
        <RegistryValue Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]MarkdownViewer.exe,0" />
        <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
        <RegistryValue Name="URLInfoAbout" Type="string" Value="https://github.com/aljazmernik/markdown-viewer" />
        <RegistryValue Name="UninstallString" Type="string" Value="&quot;[INSTALLFOLDER]MarkdownViewer.exe&quot; --uninstall" />
        <RegistryValue Name="QuietUninstallString" Type="string" Value="&quot;[INSTALLFOLDER]MarkdownViewer.exe&quot; --uninstall --quiet" />
        <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" />
        <RegistryValue Name="NoModify" Type="integer" Value="1" />
        <RegistryValue Name="NoRepair" Type="integer" Value="1" />
        <RegistryValue Name="EstimatedSize" Type="integer" Value="130000" />
      </RegistryKey>
    </Component>

    <Feature Id="Main">
      <ComponentRef Id="App" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UninstallEntry" />
    </Feature>
  </Package>
</Wix>
